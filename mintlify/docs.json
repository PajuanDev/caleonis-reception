{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Caléonis Receptionist",
  "description": "Centre d’aide Caléonis Receptionist : démarrage, appels, rendez-vous, connaissances et documentation développeur.",
  "colors": {
    "primary": "#0B0B0D",
    "light": "#FFFFFF",
    "dark": "#0B0B0D"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Geist"
  },
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo-dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Application",
        "href": "https://receptionist.caleonis.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Demander un essai",
      "name": "Demander un essai",
      "href": "https://receptionist.caleonis.com/fr/essai"
    }
  },
  "redirects": [
    {
      "source": "/agent/ai-settings",
      "destination": "/agent/ai-settings/overview"
    },
    {
      "source": "/agent/ai-settings/",
      "destination": "/agent/ai-settings/overview"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Aide en français",
        "groups": [
          {
            "group": "Premiers pas",
            "pages": [
              "introduction",
              "quickstart",
              "getting-started/account-setup",
              "getting-started/claim-your-number",
              "support/availability"
            ]
          },
          {
            "group": "Général",
            "pages": [
              "dashboard/home",
              "dashboard/calls",
              "dashboard/messages",
              "dashboard/contacts",
              "dashboard/appointments"
            ]
          },
          {
            "group": "Agent",
            "pages": [
              "agent/overview",
              {
                "group": "Paramètres IA",
                "pages": [
                  "agent/ai-settings/overview",
                  "agent/ai-settings/appointment-changes"
                ]
              },
              "agent/knowledge",
              "agent/services",
              "agent/rules"
            ]
          },
          {
            "group": "Gestion",
            "pages": [
              "dashboard/analytics",
              "integrations/overview",
              "integrations/google-calendar",
              "integrations/sms",
              "integrations/webhooks",
              {
                "group": "Réglages",
                "pages": [
                  "settings/overview",
                  "settings/account",
                  "settings/team",
                  "settings/notifications",
                  "settings/phone-number",
                  "settings/widget"
                ]
              },
              {
                "group": "Usage et offre",
                "pages": [
                  "billing/usage",
                  "billing/plans",
                  "billing/affiliate-program"
                ]
              }
            ]
          },
          {
            "group": "Aide et confiance",
            "pages": [
              "support/faq",
              "support/troubleshooting",
              "support/phone-forwarding",
              "support/recordings",
              "support/privacy",
              "attributions"
            ]
          }
        ]
      },
      {
        "tab": "Développeurs",
        "groups": [
          {
            "group": "API",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/requests",
              "api/webhooks"
            ]
          },
          {
            "group": "MCP : intégration facultative",
            "pages": [
              "ai/mcp",
              "ai/connect-claude",
              "ai/connect-chatgpt",
              "ai/connect-other-clients",
              "ai/lobbystack-skill"
            ]
          },
          {
            "group": "Référence API (EN)",
            "openapi": "api-reference/openapi.json"
          },
          {
            "group": "Instance indépendante",
            "pages": [
              "self-hosting/overview",
              "self-hosting/docker-compose",
              "self-hosting/environment-variables",
              "self-hosting/providers"
            ]
          }
        ]
      },
      {
        "tab": "English",
        "groups": [
          {
            "group": "English quick guides",
            "pages": [
              "en/overview",
              "en/quickstart"
            ]
          }
        ]
      }
    ]
  }
}
