---
import Layout from "@/layouts/main.astro"
import { Navbar } from "@/components/Navbar"
import { Footer } from "@/components/Footer"
import { CtaSection } from "@/components/CtaSection"
import { assertLocale, localizePath, type Locale } from "@/i18n"
const locale = assertLocale(
  (Astro.props as { locale?: Locale }).locale ?? Astro.currentLocale
)
const items =
  locale === "fr"
    ? [
        [
          "Configuration",
          "Accueil, services, consignes et parcours d’appel à définir ensemble.",
        ],
        [
          "Téléphonie et usage",
          "Numéro, minutes vocales, intégrations et limites à préciser avant activation.",
        ],
        [
          "Accompagnement",
          "Conditions de l’essai, support et suites du pilote à convenir explicitement.",
        ],
      ]
    : [
        [
          "Configuration",
          "Agree your greeting, services, instructions and call workflow.",
        ],
        [
          "Telephony and usage",
          "Confirm number, voice minutes, integrations and limits before activation.",
        ],
        ["Onboarding", "Explicitly agree trial terms, support and next steps."],
      ]
---

<Layout seo={{ locale, canonicalPath: localizePath(locale, "/pricing/") }}
  ><Navbar locale={locale} /><main id="main-content">
    <section class="mx-auto max-w-7xl px-6 py-16 md:py-24">
      <h1 class="display-heading">
        {locale === "fr" ? "Des tarifs sur demande" : "Pricing on request"}
      </h1><p class="body-copy mt-6 max-w-3xl">
        {
          locale === "fr"
            ? "Caléonis Receptionist est proposé en pilote accompagné. Les prix, plans et quotas sont en préparation : aucun abonnement ni débit ne peut être souscrit depuis cette prévisualisation."
            : "Caléonis Receptionist is available as an assisted pilot. Prices, plans and quotas are being prepared: this preview does not offer a subscription or take payments."
        }
      </p><div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          items.map(([title, body]) => (
            <article class="rounded-xl border border-border/70 p-6">
              <>
                <h2 class="card-heading">{title}</h2>
                <p class="body-copy mt-4">{body}</p>
              </>
            </article>
          ))
        }
      </div><p class="body-copy mt-8 max-w-3xl">
        {
          locale === "fr"
            ? "Les frais de téléphonie et des services connectés doivent être explicités dans une proposition validée. Une demande d’essai ne constitue pas une commande."
            : "Telephony and connected-service charges must be explained in an approved proposal. A trial request is not an order."
        }
      </p>
    </section><CtaSection locale={locale} />
  </main><Footer locale={locale} /></Layout
>
