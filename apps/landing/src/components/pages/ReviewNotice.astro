---
import { Navbar } from "@/components/Navbar"
import { Footer } from "@/components/Footer"
import { localizePath, type Locale } from "@/i18n"
const { locale = "fr", path = "/" } = Astro.props as {
  locale?: Locale
  path?: string
}
const legal = /\/(terms|privacy|cookie-policy|confidentialite)\//.test(path)
---

<Navbar locale={locale} /><main
  id="main-content"
  class="mx-auto min-h-[60vh] max-w-4xl px-6 py-16 md:py-24"
>
  <h1 class="display-heading">
    {
      locale === "fr"
        ? legal
          ? "Informations en cours de validation"
          : "Cette ressource est en cours de relecture"
        : legal
          ? "Information under review"
          : "This resource is under review"
    }
  </h1><p class="body-copy mt-8">
    {
      locale === "fr"
        ? legal
          ? "Les textes hérités du socle LobbyStack ne constituent pas les conditions du service Caléonis. Leur adaptation à l’activité de William Fabrice Gosse, entrepreneur individuel sous le nom commercial MrManiac, est en cours. Cette prévisualisation n’ouvre aucune souscription ni facturation."
          : "Ce contenu hérité du socle LobbyStack n’a pas encore été validé pour l’offre Caléonis Receptionist. Il est conservé dans les sources, sans présenter ses prix, comparatifs ou fonctionnalités comme disponibles."
        : legal
          ? "The inherited LobbyStack texts are not the terms of the Caléonis service. Adaptation for William Fabrice Gosse, sole proprietor trading as MrManiac, is in progress. This preview does not accept subscriptions or payments."
          : "This inherited LobbyStack resource has not yet been verified for Caléonis Receptionist. It is retained in source without presenting its prices, comparisons or capabilities as available."
    }
  </p><div class="mt-8 flex flex-wrap gap-6">
    <a
      class="underline underline-offset-4"
      href={localizePath(locale, "/resources/")}
      >{
        locale === "fr"
          ? "Aide et limites du pilote"
          : "Pilot help and limitations"
      }</a
    ><a
      class="underline underline-offset-4"
      href={localizePath(locale, "/features/")}
      >{
        locale === "fr" ? "Fonctionnalités présentées" : "Reviewed features"
      }</a>
  </div>
</main><Footer locale={locale} />
