---
import Layout from "@/layouts/main.astro"
import { Navbar } from "@/components/Navbar"
import { Footer } from "@/components/Footer"
import TradeLinks from "@/components/TradeLinks.astro"
import { CtaSection } from "@/components/CtaSection"
import { assertLocale, localizePath, type Locale } from "@/i18n"
const locale = assertLocale(
  (Astro.props as { locale?: Locale }).locale ?? Astro.currentLocale
)
---

<Layout seo={{ locale, canonicalPath: localizePath(locale, "/solutions/") }}
  ><Navbar locale={locale} /><main id="main-content">
    <section class="mx-auto max-w-7xl px-6 py-16 md:py-24">
      <h1 class="display-heading">
        {
          locale === "fr"
            ? "Vos appels ont le contexte de votre métier"
            : "Reception with your business context"
        }
      </h1><p class="body-copy mt-6 max-w-3xl">
        {
          locale === "fr"
            ? "Un même réceptionniste, des consignes adaptées à votre activité. Commencez par un besoin précis : répondre aux questions courantes, recueillir une demande ou organiser un rappel."
            : "One receptionist with instructions for your business. Start with a specific need: routine questions, capturing an enquiry or arranging a callback."
        }
      </p>
    </section><TradeLinks locale={locale} /><section
      class="mx-auto max-w-7xl px-6 py-16"
    >
      <h2 class="section-heading">
        {
          locale === "fr"
            ? "Définissez ce qui peut être confirmé"
            : "Define what can be confirmed"
        }
      </h2><p class="body-copy mt-6 max-w-3xl">
        {
          locale === "fr"
            ? "Un rendez-vous de rappel, un devis et une intervention sont des engagements différents. Vos consignes doivent les distinguer. Les situations sensibles ou urgentes nécessitent un parcours humain adapté ; aucun transfert automatique n’est promis sur le pilote."
            : "Callbacks, quotes and service visits are different commitments. Your instructions should distinguish them. Sensitive or urgent situations require an appropriate human workflow; the pilot does not promise automatic transfers."
        }
      </p>
    </section><CtaSection locale={locale} />
  </main><Footer locale={locale} /></Layout
>
