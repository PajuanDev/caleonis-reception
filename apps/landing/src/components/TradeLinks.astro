---
import { launchSolutions } from "@/lib/launch-content"
import { localizePath, type Locale } from "@/i18n"
const { locale = "fr" } = Astro.props as { locale?: Locale }
---

<section class="section-spacing border-y border-border/60 bg-muted/15">
  <div class="mx-auto max-w-7xl px-6">
    <h2 class="section-heading">
      {
        locale === "fr"
          ? "Un accueil adapté à votre activité"
          : "Reception for your business"
      }
    </h2><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        launchSolutions.map((item) => (
          <a
            href={localizePath(locale, `/solutions/${item.slug}/`)}
            class="rounded-xl border border-border/70 bg-background p-6 transition-colors hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring"
          >
            <>
              <h3 class="card-heading">{item[locale]}</h3>
              <p class="body-copy mt-3">
                {locale === "fr" ? item.frLead : item.enLead}
              </p>
            </>
          </a>
        ))
      }
    </div>
  </div>
</section>
